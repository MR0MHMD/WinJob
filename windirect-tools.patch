+/* ابزارها همان زمینه و مؤلفه‌های پنل را به ارث می‌برند. */
+.wd-panel .wd-message-text { white-space: pre-wrap; overflow-wrap: anywhere; }
+.wd-panel .wd-product-image { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
+.wd-panel .errorlist { color: var(--fi-danger, #f23c49); padding-right: 1.25rem; }
+.wd-panel .wd-child legend { font-size: 1rem; }
+.wd-panel .wd-list-row > div { min-width: 0; overflow-wrap: anywhere; }
+@media (prefers-reduced-motion: reduce) {
+    .wd-panel *, .wd-panel *::before, .wd-panel *::after { transition: none !important; }
