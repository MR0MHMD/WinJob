diff --git a/static/windirect/css/panel.css b/static/windirect/css/panel.css
index 8b13e99..33a4125 100644
--- a/static/windirect/css/panel.css
+++ b/static/windirect/css/panel.css
@@ -161,3 +161,13 @@
         white-space: nowrap;
     }
 }
