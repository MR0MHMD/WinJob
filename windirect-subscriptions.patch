@@ -0,0 +1,46 @@
+{% extends 'windirect/base.html' %}
+{% block panel_heading %}سفارش اشتراک #{{ order.pk }}{% endblock %}
+{% block panel_content %}
+    <div class="card wd-card">
+        <div class="card-body p-4">
+            <h2 class="h5 text-white">{{ order.quote.plan_name }}</h2>
+            <p class="text-light">{{ order.get_status_display }}</p>
+            {% if order.status == 'credited' %}
+                <p class="text-warning">وجه تأییدشده به کیف پول شما افزوده شده است. برای خرید اشتراک، سفارش تازه بسازید.</p>
+            {% endif %}
+            {% include 'windirect/subscriptions/amounts.html' %}
+            <div class="d-flex flex-wrap gap-2 mt-3">
+                <a class="btn btn-outline-primary"
+                   href="{% url 'payment:invoice_detail' invoice.pk %}">فاکتور</a>
+                <a class="btn btn-outline-light"
+                   href="{% url 'windirect:subscription' %}">اشتراک من</a>
+                {% if order.status == 'pending' %}
+                    <a class="btn btn-primary"
+                       href="{% url 'windirect:subscription_checkout' order.pk %}">ادامهٔ پرداخت</a>
+                {% endif %}
+            </div>
+        </div>
+    </div>
+    <div class="card wd-card mt-4">
+        <div class="card-body p-4">
+            <h2 class="h5 text-white">تلاش‌های پرداخت درگاه</h2>
+            {% for attempt in attempts %}
+                <div class="wd-list-row">
+                    <div>
+                        <span class="text-light">{{ attempt.payment.get_status_display }}</span>
+                        <small class="d-block text-muted">{{ attempt.created_at|date:'Y/m/d H:i' }} · پیگیری {{ attempt.payment.ref_id|default:'—' }}</small>
+                    </div>
+                    {% if attempt.authority and not attempt.verified_at %}
+                        <form method="post"
+                              action="{% url 'payment:subscription_reverify' attempt.pk %}">
+                            {% csrf_token %}
+                            <button class="btn btn-outline-primary btn-sm">بررسی دوباره</button>
+                        </form>
+                    {% endif %}
+                </div>
+            {% empty %}
+                <p class="text-muted">پرداخت درگاهی ثبت نشده است.</p>
+            {% endfor %}
+        </div>
+    </div>
+{% endblock %}
diff --git a/templates/windirect/subscriptions/plans.html b/templates/windirect/subscriptions/plans.html
new file mode 100644
index 0000000..9f99ab0
--- /dev/null
+++ b/templates/windirect/subscriptions/plans.html
@@ -0,0 +1,80 @@
+{% extends 'windirect/base.html' %}
+{% load humanize %}
+{% block windirect_title %}پلن‌های وین دایرکت{% endblock %}
+{% block panel_heading %}انتخاب اشتراک وین دایرکت{% endblock %}
+{% block panel_intro %}یک اشتراک برای کاربر؛ امکانات نامحدود با سقف پیج مشخص{% endblock %}
+{% block panel_action %}
+    <a class="btn btn-outline-primary rounded-pill"
+       href="{% url 'windirect:subscription' %}">اشتراک و سوابق من</a>
+{% endblock %}
+{% block panel_content %}
+    <div class="row g-4">
+        {% for plan in plans %}
+            <div class="col-lg-4">
+                <article class="card wd-card h-100">
+                    <div class="card-body p-4">
+                        {% if plan.is_featured %}
+                            <span class="badge bg-faded-primary text-primary mb-3">پیشنهاد وین دایرکت</span>
+                        {% endif %}
+                        <h2 class="h4 text-white">{{ plan.name }}</h2>
+                        <p class="text-muted">{{ plan.description }}</p>
+                        <p class="text-light">
+                            <strong class="text-primary">{{ plan.max_pages }}</strong> پیج مجاز
+                        </p>
+                        <ul class="wd-help-list text-light mb-4">
+                            <li>کامنت هوشمند: {% if plan.smart_comments %}دارد{% else %}ندارد{% endif %}</li>
+                            <li>دایرکت هوشمند: {% if plan.smart_direct %}دارد{% else %}ندارد{% endif %}</li>
+                            <li>ویترین‌ساز: {% if plan.showcases %}دارد{% else %}ندارد{% endif %}</li>
+                            <li>فرم‌ساز و اکسل: {% if plan.forms %}دارد{% else %}ندارد{% endif %}</li>
+                        </ul>
+                        {% for offer in plan.offers.all %}
+                            {% if offer.is_active %}
+                                <div class="border-top border-light pt-3 mt-3">
+                                    <p class="text-light mb-2">{{ offer.get_duration_days_display }} · <strong>{{ offer.price|intcomma }}</strong> تومان {% if not plan.is_trial %}
+                                        <small class="text-muted">پیش از مالیات</small>
+                            {% endif %}
+                            </p>
+                        {% if plan.is_trial %}
+                            {% if account.trial_used_at or account.first_paid_at %}
+                                <span class="text-muted">رایگان قبلاً استفاده شده یا خرید پولی انجام شده است.</span>
+                            {% else %}
+                                <form method="post" action="{% url 'windirect:trial_activate' offer.pk %}">
+                                    {% csrf_token %}
+                                    <button class="btn btn-outline-primary w-100">فعال‌سازی رایگان ۳۰ روزه</button>
+                                </form>
+                            {% endif %}
+                        {% else %}
+                            {% if plan.level < account.highest_level %}
+                                <span class="text-muted">کاهش پلن مجاز نیست.</span>
+                            {% elif paid_reference and plan.level > paid_reference.capabilities.level %}
+                                {% if offer.duration_days == paid_reference.duration_days %}
+                                    <a href="{% url 'windirect:subscribe' offer.pk %}?kind=upgrade"
+                                       class="btn btn-primary w-100">محاسبهٔ ارتقا</a>
+                                {% else %}
+                                    <span class="text-muted">برای ارتقا گزینهٔ {{ paid_reference.duration_days }} روزه را انتخاب کنید.</span>
+                                {% endif %}
